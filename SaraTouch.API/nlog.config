<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<targets>
		<!-- קובץ לוג חדש כל יום -->
		<target xsi:type="File" name="file"
				fileName="${basedir}/logs/saratouch-${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

		<target xsi:type="Console" name="console"
				layout="${time} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${message} ${exception:format=tostring}" />
	</targets>

	<rules>
		<!-- הלוגים של Microsoft רועשים: מהם עוברים רק Warning ומעלה -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<!-- מהקוד שלנו נכתב הכול, מ-Debug ומעלה -->
		<logger name="*" minlevel="Debug" writeTo="file,console" />
	</rules>
</nlog>